{
  "name": "@kreeptales/pixel-glyph",
  "version": "0.1.0",
  "description": "Crisp pixel-art glyphs from bitmap strings: one SVG rect per run, crispEdges, palettes as CSS variables, no seams at fractional scales.",
  "license": "MIT",
  "author": "KreepTales",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kreeptales/pixel-glyph.git"
  },
  "homepage": "https://github.com/kreeptales/pixel-glyph#readme",
  "bugs": "https://github.com/kreeptales/pixel-glyph/issues",
  "keywords": [
    "pixel-art",
    "bitmap",
    "svg",
    "sprite",
    "icon",
    "react",
    "crisp-edges",
    "retro"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    }
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "typecheck": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run lint && npm test && npm run build",
    "site:dev": "vite --config site/vite.config.ts",
    "site:build": "vite build --config site/vite.config.ts",
    "site:preview": "vite preview --config site/vite.config.ts"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "jsdom": "^30.0.1",
    "oxlint": "^1.79.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
